# Local secrets and configuration
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and generated output
node_modules/
.pnpm-store/
.next/
.output/
.wxt/
dist/
coverage/
*.log

# Local system and editor state
.DS_Store
.idea/

# Private learner material and local recordings
local-data/
recordings/

# Development and test artifacts
.local/
.superpowers/
playwright-report/
test-results/
*.tsbuildinfo
next-env.d.ts

.local-*.log

# Isolated Python translation runtime
.venv/
__pycache__/

# Godot import caches and generated identifiers are recreated by world:build.
games/cafe/.godot/

# Godot 2D caches and reproducible Web export
games/arcade/.godot/
apps/web/public/arcade-engine/

# Unity caches and reproducible generated scene/art
games/unity/Library/
games/unity/Temp/
games/unity/Logs/
games/unity/obj/
games/unity/UserSettings/
games/unity/Assets/Art/
games/unity/Assets/Art.meta
games/unity/Assets/Generated/
games/unity/Assets/Generated.meta
# Unity's unused default scene-template catalog is regenerated by the Editor.
games/unity/ProjectSettings/SceneTemplateSettings.json

# Regenerated Unity Addressables pointer and build catalogs
games/unity/Assets/AddressableAssetsData/
games/unity/Assets/AddressableAssetsData.meta

# Unity performance-package build metadata is generated, not project data.
games/unity/Assets/Resources/PerformanceTestRun*.json*

# Compiled from tools/unity/mac-microphone.mm by unity:prepare.
games/unity/Assets/Plugins/macOS/*.dylib*

# Forest Café logic checks (dotnet)
tools/unity/slice-checks/bin/
tools/unity/slice-checks/obj/

# Blender keeps editable sources; backup revisions are local only.
art/blender/*.blend[0-9]*

# Native Meshy Downloads library: user source assets, regenerated locally (multi-GB).
games/unity/Assets/_Game/Art/MeshyLibrary/
games/unity/Assets/_Game/Art/MeshyLibrary.meta

# Reproducible game copies of user-provided FBXs; importer manifests stay in source control.
games/unity/Assets/_Game/Art/Motion/*.fbx*
games/unity/Assets/_Game/Art/Motion/Textures/
games/unity/Assets/_Game/Art/WorldAssets/*.glb*
games/unity/Assets/_Game/Art/WorldAssets/World*.json*
games/unity/Assets/_Game/Art/WorldAssets/.staging/
