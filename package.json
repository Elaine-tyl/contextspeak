{
  "name": "contextspeak",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build:extension && playwright test",
    "dev": "tsx scripts/dev.ts",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "build:extension": "pnpm --filter @contextspeak/extension build",
    "build:web": "pnpm --filter @contextspeak/web build",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{ts,json,yaml}\" \"games/**/*.{ts,js,json}\"",
    "dev:test": "CONTEXTSPEAK_TEST_AUTH=1 TRANSLATION_PROVIDER=fixture tsx scripts/dev.ts",
    "dev:local": "CONTEXTSPEAK_TEST_AUTH=1 tsx scripts/dev.ts",
    "translator:setup": "tsx scripts/translator.ts --setup",
    "translator:start": "tsx scripts/translator.ts",
    "test:translation:live": "pnpm build:extension && playwright test --config playwright.translation.config.ts",
    "test:popup": "pnpm build:extension && playwright test --config playwright.popup.config.ts",
    "ai:setup": "tsx scripts/local-ai.ts --setup",
    "test:gemini:live": "pnpm build:extension && playwright test --config playwright.gemini.config.ts",
    "test:ai:live": "pnpm build:extension && playwright test --config playwright.ai.config.ts",
    "speech:setup": "tsx scripts/local-speech.ts --setup",
    "content:verify": "tsx scripts/practice-content.ts",
    "world:setup": "python3 tools/world/setup.py",
    "world:build": "python3 tools/world/build.py",
    "world:test": "python3 tools/world/build.py --test",
    "world:dev": "tsx scripts/world.ts",
    "world:test:voice": "tsx scripts/world-voice-fixture.ts && CONTEXTSPEAK_WORLD_VOICE_TEST=1 playwright test --config playwright.world.config.ts local-voice"
  },
  "devDependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@playwright/test": "1.65.0",
    "@prisma/client": "6.19.3",
    "@types/chrome": "0.3.7",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@wxt-dev/module-react": "1.2.2",
    "embedded-postgres": "18.6.0-beta.19",
    "jose": "6.2.15",
    "magicast": "0.3.5",
    "next": "16.4.5",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wxt": "0.21.5",
    "zod": "4.6.7"
  }
}
