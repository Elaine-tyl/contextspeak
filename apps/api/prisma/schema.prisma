generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  issuer            String
  subject           String
  collectionEnabled Boolean        @default(false)
  excludedOrigins   String[]       @default([])
  consentVersion    Int            @default(0)
  extensionVersion  Int            @default(0)
  translationPreferences Json?
  items             LearningItem[]
  lookups           LookupEvent[]
  sessions          AuthSession[]
  pairings          ExtensionPairing[]

  @@unique([issuer, subject])
}

model LearningItem {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text           String
  normalized     String
  sourceLanguage String
  targetLanguage String
  senseStatus    String        @default("unresolved")
  status         String        @default("candidate")
  createdAt      DateTime      @default(now())
  lookups        LookupEvent[]
  reviewCard     ReviewCard?

  @@unique([userId, normalized, sourceLanguage, targetLanguage])
  @@unique([id, userId])
}

model LookupEvent {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId           String
  payloadHash       String
  candidateId       String
  candidate         LearningItem @relation(fields: [candidateId, userId], references: [id, userId], onDelete: Cascade)
  text              String
  context           String?
  sourceUrl         String?
  sourceLanguage    String
  targetLanguage    String
  translationStatus String       @default("pending")
  detectedSourceLanguage String?
  meaning           String?
  learningDetails   Json?
  provider          String?
  errorCode         String?
  createdAt         DateTime     @default(now())

  @@unique([userId, eventId])
  @@index([userId, createdAt, id])
  @@index([translationStatus])
}

model LoginAttempt {
  stateHash   String   @id
  browserHash String
  verifier    String
  nonce       String
  destination String
  expiresAt   DateTime
}

model AuthSession {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  extensionVersion Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

model ExtensionPairing {
  deviceHash   String    @id
  userCodeHash String    @unique
  userId       String?
  extensionVersion Int @default(0)
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  consumedAt   DateTime?
  lastPolledAt DateTime?

  @@index([expiresAt])
}

model ReviewCard {
  itemId    String       @id
  userId    String
  item      LearningItem @relation(fields: [itemId, userId], references: [id, userId], onDelete: Cascade)
  prompt    String
  answer    String
  context   String?
  active    Boolean      @default(true)
  dueAt     DateTime
  schedule  Json
  version   Int          @default(0)
  createdAt DateTime     @default(now())
  events    ReviewEvent[]

  @@unique([itemId, userId])
  @@index([userId, active, dueAt])
}

model ReviewEvent {
  id        String     @id @default(uuid())
  userId    String
  eventId   String
  itemId    String
  card      ReviewCard @relation(fields: [itemId, userId], references: [itemId, userId], onDelete: Cascade)
  rating    String
  version   Int
  dueAt     DateTime
  log       Json
  createdAt DateTime   @default(now())

  @@unique([userId, eventId])
}
