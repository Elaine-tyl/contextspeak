  m_Script: {fileID: 11500000, guid: 33b6cfb8e845d4eb0b8a01c56b5c1ae6, type: 3}
  m_Name: Nurse Call
  m_EditorClassIdentifier: Assembly-CSharp::ContextSpeak.Life.ScenarioDefinition
  Title: Nurse Call
  Location: Hospital
  Steps:
  - id: confirm
    speaker: nurse
    simple: Hello. What is your name?
    standard: Hi there, number called. Can you confirm your name for me?
    advanced: Hello, you're next. Before we go through, can you confirm your full
      name and date of birth?
    expert: 
    goal: Confirm who you are.
    meaning: i'?m|i am|it'?s|my name|name is|yes|that'?s me|me|\d|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|zero|oh|twenty|thirty
    model: Yes, that's me. I'm Emma Lee.
    vocabulary: 'confirm: say it is correct'
    onComplete: 
  - id: walk
    speaker: nurse
    simple: Please come with me. Are you okay to walk?
    standard: The doctor will see you in room two. Are you okay to walk there with
      me?
    advanced: Doctor Patel is ready for you in consultation room two. Are you comfortable
      walking, or would you like a wheelchair?
    expert: 
    goal: Answer the nurse.
    meaning: yes|yeah|yep|sure|of course|okay|ok|please|that'?s right|correct|no|nope|not|never|none|nothing|i
      don'?t|walk|fine|wheelchair|can|need|help|thank
    model: Yes, I can walk, thank you.
    vocabulary: 'wheelchair: a chair with wheels for people who cannot walk'
    onComplete: to-consultation
