  m_Name: Restaurant Drinks
  m_EditorClassIdentifier: Assembly-CSharp::ContextSpeak.Life.ScenarioDefinition
  Title: Restaurant Drinks
  Location: Restaurant
  Steps:
  - id: drinks
    speaker: waiter
    simple: Here is the menu. A drink?
    standard: Here's the menu. Can I get you something to drink while you decide?
    advanced: Here are your menus. While you're deciding, can I start you off with
      something to drink?
    expert: 
    goal: Order a drink (or say just water).
    meaning: water|juice|cola|soda|lemonade|tea|coffee|drink|sparkling|still|tap|no|nope|not|never|none|nothing|i
      don'?t|just|please|i'?d like|can i|could i
    model: Could I have a sparkling water, please?
    vocabulary: 'sparkling: with bubbles|still: without bubbles'
    onComplete: open-menu
