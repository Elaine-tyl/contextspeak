/* Auxiliary cafe / first-day views share Theme.uss control styling. */
:root { color: #1F2A26; font-size: 15px; }
#hud { position: absolute; top: 24px; left: 24px; max-width: 340px; padding: 12px 16px; background-color: rgba(247, 243, 234, 0.92); border-radius: 10px; }
Label { white-space: normal; margin-bottom: 8px; }
#hud > Label { margin-bottom: 4px; }
.context-actions { margin-top: 4px; font-size: 13px; }
.context-actions > .unity-foldout__content { padding-top: 8px; }
#dialogue { position: absolute; bottom: 32px; left: 50%; translate: -50% 0; width: 620px; max-width: 94%; max-height: 48%; background-color: rgba(247, 243, 234, 0.97); border-radius: 10px; padding: 16px; font-size: 15px; }
.speaker { font-size: 18px; -unity-font-style: bold; color: #2E5E45; }
#dialogue Button { min-height: 42px; padding: 8px 12px; }
.buttons { flex-direction: row; flex-wrap: wrap; }
.nearby { position: absolute; bottom: 34%; align-self: center; color: #F7F3EA; background-color: rgba(31, 42, 38, 0.94); padding: 8px 12px; border-radius: 999px; font-size: 15px; }
#dialogue TextField > .unity-text-field__input { padding: 8px; }
#life-menu { position: absolute; top: 24px; right: 24px; width: 320px; max-width: 42%; max-height: 82%; padding: 16px; background-color: #F7F3EA; border-radius: 10px; overflow: hidden; }
#repair { color: #B54A3A; background-color: #F5E7D7; padding: 12px; border-radius: 8px; }
.menu-item { margin-top: 8px; padding: 12px; border-radius: 8px; background-color: #FFFCF6; border-width: 1px; border-color: #D4DBD3; }
.menu-item.planned { border-color: #C47A2C; background-color: #F5E7D7; }
.menu-item > Label { margin-bottom: 4px; font-size: 13px; color: #48574E; }
.menu-item > .menu-item-title { font-size: 18px; -unity-font-style: bold; color: #1F2A26; }
.menu-item > .menu-item-phrase { color: #2E5E45; -unity-font-style: italic; }
.menu-item > Button { align-self: flex-start; min-height: 36px; padding: 4px 12px; font-size: 13px; }
