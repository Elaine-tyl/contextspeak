  m_Script: {fileID: 11500000, guid: eacb2f7c41a246efb537575538b1ef0f, type: 3}
  m_Name: school-7-9
  m_EditorClassIdentifier: 
  Definition:
    Id: "school"
    Npc: "Ms Taylor"
    Topic: "learning"
    ItemId: "polite-requests"
    Prompt: "Your class disagrees about exam preparation versus practical skills. Ask for clarification, compare perspectives and suggest a balanced approach."
    Goal: "Respond to the current question with a relevant, clear request or explanation. Accept natural alternatives; study vocabulary is optional."
    Model: "Could you explain how we can balance exam preparation with practical skills? Exams provide goals, whereas projects develop independence. A mixture might work better."
    ObjectWord: "desk|book|timetable"
    RecallPrompt: "Ask the teacher for help with a different class task, in your own words."
    StressTip: "Reference practice, not a diagnosis: stress the key information word. In \"Could you help me?\", /kəd jə/ is a common connected form. Intonation depends on intent; understandable accents are welcome."
    Band: 7
    Vocabulary:
    - "homework"
    - "feedback"
    - "class"
    - "teacher"
  MinBand: 7
  MaxBand: 9
  ReviewDays: 0100000003000000070000000e000000
