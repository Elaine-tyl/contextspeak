  m_Name: school-5-6
  m_EditorClassIdentifier: 
  Definition:
    Id: "school"
    Npc: "Ms Taylor"
    Topic: "learning"
    ItemId: "polite-requests"
    Prompt: "You missed part of the homework instructions. Ask your teacher to clarify them and explain what you did understand."
    Goal: "Respond to the current question with a relevant, clear request or explanation. Accept natural alternatives; study vocabulary is optional."
    Model: "Could you explain the homework instructions again? I understand that we need to write a paragraph, but I missed the deadline."
    ObjectWord: "desk|book|timetable"
    RecallPrompt: "Ask the teacher for help with a different class task, in your own words."
    StressTip: "Reference practice, not a diagnosis: stress the key information word. In \"Could you help me?\", /kəd jə/ is a common connected form. Intonation depends on intent; understandable accents are welcome."
    Band: 5
    Vocabulary:
    - "homework"
    - "feedback"
    - "class"
    - "teacher"
  MinBand: 5
  MaxBand: 6
  ReviewDays: 0100000003000000070000000e000000
