extends SceneTree

const Mission = preload("../scripts/mission.gd")
const Recorder = preload("../scripts/recorder.gd")
var failures := 0

func check(condition: bool, message: String) -> void:
	if not condition:
		failures += 1
		push_error(message)

func _initialize() -> void:
	var mission = Mission.new()
	mission.apply({"action": "confirm"})
	check(not mission.state.complete, "Confirmation cannot bypass the mission")
	mission.apply({"action": "order", "items": [{"drink": "latte", "quantity": 2}]})
	check(mission.state.stage == "order", "An over-budget order must be corrected")
	check(not mission.state.get("items", {}).is_empty(), "Keep the rejected order visible for correction")
	mission.apply({"action": "order", "items": [{"drink": "coffee", "quantity": 2}]})
	check(mission.state.stage == "temperature", "A valid two-drink order advances")
	mission.apply({"action": "temperature", "temperature": "iced"})
	mission.apply({"action": "service", "service": "takeaway"})
	check(mission.state.stage == "confirm", "Remember temperature and service before confirmation")
	var reply: Dictionary = mission.apply({"action": "confirm"})
	check(mission.state.complete, "An explicit confirmation completes a valid order")
	check(reply.get("score") == 100, "Full communication goals earn full task progress")
	check(mission.summary().get("reward") == 2, "Reward exactly two drinks")
	mission.apply({"action": "confirm"})
	check(mission.summary().get("reward") == 2, "Repeated confirmation cannot duplicate rewards")
	var restored = Mission.new()
	check(restored.restore(mission.state.duplicate(true)), "Valid guest progress can be restored")
	check(restored.state.complete, "Completed progress survives restart")
	check(not restored.restore({"complete": true, "reward": 999}), "Reject incomplete/tampered save shapes")
	check(not restored.state.complete, "Invalid saves return to a safe fresh mission")
	var corrected = Mission.new()
	corrected.apply({"action": "order", "items": [{"drink": "tea", "quantity": 2}]})
	corrected.apply({"action": "temperature", "temperature": "hot"})
	corrected.apply({"action": "order", "items": [{"drink": "coffee", "quantity": 1}, {"drink": "latte", "quantity": 1}]})
	check(corrected.state.stage == "temperature", "An edited order clears old options")
	check(corrected.state.get("temperature") == "", "Do not silently reuse old temperatures")
	var invalid = Mission.new()
	invalid.apply({"action": "order", "items": [{"drink": "coffee", "quantity": -2}]})
	check(invalid.state.stage == "order", "Negative quantities cannot create a free order")
	invalid.apply({"action": "order", "items": [{"drink": "gold", "quantity": 2}]})
	check(invalid.state.stage == "order", "Models cannot invent menu items")
	check(invalid.parse("How much is a latte?").action == "ask_price", "A price question is not an order")
	var parsed: Dictionary = invalid.parse("Two iced coffees to go, please.")
	check(parsed.action == "order", "Understand a common polite order without a model")
	check(parsed.get("items", []).size() == 1, "Parse the actual ordered drink")
	check(parsed.get("temperature") == "iced", "Keep temperature from a complete request")
	invalid.apply(parsed)
	check(invalid.state.stage == "confirm", "A complete request does not force redundant questions")
	invalid.apply({"action": "ask_price"})
	check(invalid.state.stage == "confirm", "Questions do not lose the current order")
	invalid.apply({"action": "cancel"})
	check(invalid.state.stage == "order" and not invalid.state.complete, "Cancellation never grants a pass")
	invalid.apply({"action": "order", "items": [{"drink": "tea", "quantity": 2.0}]})
	check(invalid.state.stage == "temperature", "Accept exact JSON numeric quantities from the local model")
	invalid.apply({"action": "cancel"})
	invalid.apply({"action": "order", "items": [{"drink": "tea", "quantity": 1.5}]})
	check(invalid.state.stage == "order", "Reject fractional model quantities")
	for answer in ["That's incorrect.", "Yesterday was good.", "No, that is correct.", "That isn't correct.", "That isn’t correct."]:
		var agreement = Mission.new()
		agreement.apply(agreement.parse("Two iced coffees to go, please."))
		agreement.apply(agreement.parse(answer))
		check(not agreement.state.complete, "Negative or unrelated speech cannot confirm: " + answer)
	for answer in ["Is that correct?", "I said yes yesterday.", "Could you say yes?"]:
		var question = Mission.new()
		question.apply(question.parse("Two iced coffees to go, please."))
		question.apply(question.parse(answer))
		check(not question.state.complete, "A question or reported speech is not agreement: " + answer)
	var edit = Mission.new()
	edit.apply(edit.parse("Two iced coffees to go, please."))
	edit.apply(edit.parse("Actually, for here please."))
	check(edit.state.service == "here" and edit.state.stage == "confirm", "A learner can correct service before confirmation")
	edit.apply(edit.parse("Not iced, hot please."))
	check(edit.state.temperature == "hot", "A learner can correct a negated temperature choice")
	for answer in ["I don't want iced", "I don’t want iced", "not take away"]:
		var refusal = Mission.new()
		refusal.apply(refusal.parse("Two hot coffees for here, please."))
		refusal.apply(refusal.parse(answer))
		check(refusal.state.temperature == "hot" and refusal.state.service == "here", "A rejected option must not be selected: " + answer)
	var recording := AudioStreamWAV.new()
	recording.mix_rate = 16000
	recording.format = AudioStreamWAV.FORMAT_16_BITS
	var pcm := PackedByteArray()
	pcm.resize(640320)
	recording.data = pcm
	var microphone = Recorder.new()
	check(microphone.has_method("contains_speech"), "Detect silent recordings before transcription")
	if microphone.has_method("contains_speech"):
		check(not microphone.contains_speech(recording), "Silence must not count as a spoken reply")
		for sample in 3200:
			pcm.encode_s16(sample * 2, 1200 if sample % 2 else -1200)
		recording.data = pcm
		check(microphone.contains_speech(recording), "Audible speech-like PCM can be submitted")
	microphone.free()
	var encoded: PackedByteArray = Recorder.wave(recording)
	check(encoded.size() == 640044, "Frame-delayed recording stops are trimmed to exactly 20 seconds")
	check(encoded.decode_u32(40) == encoded.size() - 44, "Trimmed WAV has exact data lengths")
	print("Cafe mission checks: ", "passed" if failures == 0 else "%d failed" % failures)
	quit(0 if failures == 0 else 1)
