# Copy to .env.local (ignored by Git). Never add real secrets to this example.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_ORIGIN=http://127.0.0.1:4318
WEB_ORIGIN=http://127.0.0.1:3000
# Browser-build variables contain public origins only, never secrets.
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:4318
WXT_API_ORIGIN=http://127.0.0.1:4318
WXT_WEB_ORIGIN=http://127.0.0.1:3000
# pnpm dev manages its own local database. Used by Prisma commands/hosted API.
DATABASE_URL=postgresql://contextspeak:contextspeak@127.0.0.1:55432/contextspeak

# Free local translator is started automatically by pnpm dev. No API key.
TRANSLATION_PROVIDER=ollama
# Optional: use an already-running self-hosted LibreTranslate service instead.
# TRANSLATOR_URL=http://127.0.0.1:5001

# Local AI uses the pinned qwen3:4b model.
# OLLAMA_URL=http://127.0.0.1:11434

# Optional cloud explanations. Keep the project unpaid to use its free quota.
# TRANSLATION_PROVIDER=gemini
# GEMINI_API_KEY=

# Natural AI word/example pronunciation; keep API keys server-side.
# Local English voice; download once with pnpm speech:setup.
SPEECH_PROVIDER=ollama
# Optional existing cloud voices for languages unsupported by Phonon.
SPEECH_NON_ENGLISH_PROVIDER=gemini
SPEAKING_PROVIDER=gemini
# Optional consent-gated speaking assessment reuses this server-side Gemini key.
# It is enabled when Gemini translation or AI speech is selected; no extra key is needed.
